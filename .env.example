# Slack app credentials (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Command Code Provider API (https://commandcode.ai/docs/provider)
# Create a key in Studio -> API keys; the same key authenticates the CLI and the API.
COMMANDCODE_API_KEY=your-cmd-api-key

# --- optional ---
# Model id (exact). Claude models go to /v1/messages, everything else to /v1/chat/completions.
VERITY_MODEL=deepseek/deepseek-v4-flash
# Override the API root or the wire if you point Verity at something else.
# VERITY_BASE_URL=https://api.commandcode.ai/provider/v1
# VERITY_WIRE=anthropic
# Enforce zero data retention on every request.
# CMD_ZDR=1

# Length of one "in-game day" in milliseconds. Lower it to fast-forward the corruption arc.
# 60000 = one day per minute (great for demos).
VERITY_DAY_MS=86400000
# Pin the day counter (ignores the clock). Handy for testing a specific phase.
# VERITY_FORCE_DAY=4
# Also answer un-mentioned channel messages that begin with "Hey Verity".
# Requires the message.channels event + channels:history / channels:read scopes.
VERITY_WATCH_CHANNELS=false
# Where the day counter is stored.
VERITY_STATE_FILE=.verity-state.json
